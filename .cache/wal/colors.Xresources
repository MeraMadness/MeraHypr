! X colors.
! Generated by 'wal'
*foreground:        #cccccc
*background:        #040404
*.foreground:       #cccccc
*.background:       #040404
emacs*foreground:   #cccccc
emacs*background:   #040404
URxvt*foreground:   #cccccc
XTerm*foreground:   #cccccc
UXTerm*foreground:  #cccccc
URxvt*background:   [100]#040404
XTerm*background:   #040404
UXTerm*background:  #040404
URxvt*cursorColor:  #cccccc
XTerm*cursorColor:  #cccccc
UXTerm*cursorColor: #cccccc
URxvt*borderColor:  [100]#040404

! Colors 0-15.
*.color0: #040404
*color0:  #040404
*.color1: #605F60
*color1:  #605F60
*.color2: #717072
*color2:  #717072
*.color3: #798358
*color3:  #798358
*.color4: #807F80
*color4:  #807F80
*.color5: #929293
*color5:  #929293
*.color6: #A09F9F
*color6:  #A09F9F
*.color7: #cccccc
*color7:  #cccccc
*.color8: #8e8e8e
*color8:  #8e8e8e
*.color9: #605F60
*color9:  #605F60
*.color10: #717072
*color10:  #717072
*.color11: #798358
*color11:  #798358
*.color12: #807F80
*color12:  #807F80
*.color13: #929293
*color13:  #929293
*.color14: #A09F9F
*color14:  #A09F9F
*.color15: #cccccc
*color15:  #cccccc

! Black color that will not be affected by bold highlighting.
*.color66: #040404
*color66:  #040404

! Xclock colors.
XClock*foreground: #cccccc
XClock*background: #040404
XClock*majorColor:  rgba:cc/cc/cc/ff
XClock*minorColor:  rgba:cc/cc/cc/ff
XClock*hourColor:   rgba:cc/cc/cc/ff
XClock*minuteColor: rgba:cc/cc/cc/ff
XClock*secondColor: rgba:cc/cc/cc/ff

! Set depth to make transparency work.
URxvt*depth: 32
