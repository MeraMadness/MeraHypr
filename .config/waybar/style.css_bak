@import url("/home/mera/.cache/wal/colors-waybar.css"); /* Ensure pywal colors load */

* {
  font-family: "Segoe UI", "Iosevka Nerd Font", sans-serif;
  font-size: 15px;
  font-weight: 500;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
  background: transparent;
  color: @foreground;
}

/* Main bar background — glassy dark */
window#waybar {
  background-color: rgba(30, 30, 30, 0.7); /* translucent black */
  border-radius: 0px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  border-bottom: 2px solid rgba(0, 0, 0, 0.5);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  padding: 3px 12px;
  margin: 0;
  opacity: 1.0;
}

/* Module default style */
#workspaces,
#cpu,
#memory,
#temperature,
#clock,
#pulseaudio,
#network,
#battery,
#tray,
#custom-media {
  background-color: rgba(255, 255, 255, 0.06);
  color: @foreground;
  padding: 5px 12px;
  margin: 0 4px;
  border-radius: 6px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  text-shadow: 0px 0px 3px rgba(0, 0, 0, 0.8);
}

/* Workspaces: round buttons, focused highlight like Vista */
#workspaces button {
  background-color: transparent;
  color: @foreground;
  margin: 0 3px;
  padding: 4px 8px;
  border-radius: 4px;
  transition: background 0.2s ease-in-out;
}

#workspaces button.focused {
  background-color: @color2; /* Pywal-accented color */
  color: black;
  font-weight: bold;
}

/* Special states */
#pulseaudio.muted {
  background-color: rgba(200, 50, 50, 0.4);
  color: white;
}

#battery.critical:not(.charging) {
  background-color: rgba(255, 0, 0, 0.4);
  color: white;
}

#tray {
  padding: 0 6px;
}

/* Remove hardcoded white */
#clock,
#network,
#battery,
#pulseaudio,
#cpu,
#memory,
#temperature {
  color: @foreground;
}

#workspaces:hover,
#cpu:hover,
#memory:hover,
#temperature:hover,
#clock:hover,
#pulseaudio:hover,
#network:hover,
#battery:hover,
#tray:hover,
#custom-media:hover {
  background-color: rgba(255, 255, 255, 0.15);
  transition: background-color 0.3s ease;
}

